{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIDI Randomiser device",
  "type": "object",
  "required": ["name", "manufacturer", "schemaVersion", "parameters"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "manufacturer": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "const": 1 },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/parameter" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["name", "type", "number", "min", "max", "enabled"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["cc", "nrpn"] },
        "number": { "type": "integer", "minimum": 0 },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "cc" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "number": { "type": "integer", "maximum": 127 },
              "min": { "type": "integer", "maximum": 127 },
              "max": { "type": "integer", "maximum": 127 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "nrpn" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "number": { "type": "integer", "maximum": 16383 },
              "min": { "type": "integer", "maximum": 16383 },
              "max": { "type": "integer", "maximum": 16383 }
            }
          }
        }
      ]
    }
  }
}
